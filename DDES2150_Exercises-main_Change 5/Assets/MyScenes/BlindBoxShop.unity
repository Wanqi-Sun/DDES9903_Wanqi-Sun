  m_Name: 
  m_EditorClassIdentifier: 
  dialogUI: {fileID: 1369598113}
  dialogText: {fileID: 494553548}
  dialogLines:
  - 'Girl: Aww... I can''t get my favourite box...'
  - 'User: What can I do for you?'
  - 'Girl: Could  you help me get my favourite box? I hear that it is the lightest
    box.'
  - 'Girl: I accidentally lost my small electronic scale. It should still be in this
    store. If you can help me find it, you can weigh each blind box.'
  - 'Girl: If you can help me get my favourite blind box, I''ll give you a surprise.'
  - 'User: Of course.'
